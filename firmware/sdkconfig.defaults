# Power Management - Light Sleep
CONFIG_PM_ENABLE=y
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y
# CONFIG_PM_DFS_INIT_AUTO is not set

CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_PM_SLP_DISABLE_GPIO=y
CONFIG_PM_LIGHTSLEEP_RTC_OSC_CAL_INTERVAL=1
# Note: Peripheral power down disabled to allow GPIO wakeup
# CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP is not set

# Task Watchdog
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# IEEE 802.15.4 (Zigbee) Sleep
CONFIG_IEEE802154_SLEEP_ENABLE=y

# Higher tick rate for lower sleep threshold
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# Sleep power optimization
# Note: Flash power down disabled - test on hardware before enabling
# CONFIG_ESP_SLEEP_POWER_DOWN_FLASH is not set
#CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y
CONFIG_ESP_PHY_MAC_BB_PD=y
#CONFIG_ESP_SLEEP_SET_FLASH_DPD=y
#CONFIG_ESP_SLEEP_FLASH_LEAKAGE_WORKAROUND=y

# Disable hardware crypto for sleep compatibility
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_HARDWARE_SHA=n

# Zigbee End Device
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# mbedTLS settings for Zigbee
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

# Log: all logging removed for production
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_LOG_MAXIMUM_LEVEL=0
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# CPU frequency (keep in sync with APP_PM_MAX_FREQ_MHZ)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_120 is not set
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set

CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n

# Console disabled for production (log level 0 anyway)
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_CONSOLE_UART_NONE=y
CONFIG_ESP_CONSOLE_UART_NONE=y
CONFIG_CONSOLE_UART_NUM=-1

CONFIG_FREERTOS_UNICORE=y

