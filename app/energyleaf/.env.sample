# Energyleaf environment variables
# Copy to .env.development.local for development or fill in your deployment config.
# Only CRON_SECRET and a Database connection are required; everything else is optional and falls back
# to sensible defaults (see src/env.ts for the exact validation rules).

# --- Database (PostgreSQL) ---
# Either set DATABASE_URL directly ...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/energyleaf"
# ... or the individual variables (used when DATABASE_URL is not set)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="energyleaf"

# --- Cron authentication (required) ---
# Secret that is used by the cron Jobs to authenticate.
CRON_SECRET="change-me"

# --- Feature flags ("true"/"1" = disable the feature; defaults in parentheses) ---
DISABLE_SIGNUP="false"      # public signup (default: false)
DISABLE_EXPERIMENT="false"  # study/experiment mode (default: false)
DISABLE_TRACKING="true"     # page view tracking (default: true)
DISABLE_LOGS="true"         # log storage (default: true)
DISABLE_DEMO="true"         # demo login on the login page (default: true)

# --- App URL (optional) ---
# Public base URL of your instance, used for links in mails (e.g. password reset).
# Used when not deployed on Vercel; falls back to http://localhost:3000 if unset.
APP_URL="http://localhost:3000"

# --- Object storage (S3-compatible, e.g. MinIO; optional) ---
# Enables S3-backed file storage. Leave empty to disable. It is not needed to run the Application and only allows a user during self handled user creation to upload images of their meter.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# --- Mail via Nodemailer (optional) ---
# SMTP server for password reset and system mails. Leave empty to disable mails.
# Reset links use the Vercel URL on Vercel, otherwise APP_URL (see src/server/lib/mail.ts).
NODEMAILER_MAIL="energyleaf@example.com"
NODEMAILER_ENDPOINT="smtp.example.com"
NODEMAILER_PORT="587"

# --- Weather forecast (optional) ---
# weatherapi.com key for solar forecast and weather data. Leave empty to disable.
WEATHERAPI_KEY=""

