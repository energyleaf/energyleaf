FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json .
RUN npm install --omit=dev

FROM node:20-alpine
RUN apk add --no-cache dcron
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json .
COPY drain.ts .
COPY crontab /etc/crontabs/root
CMD ["crond", "-f", "-d", "8"]
